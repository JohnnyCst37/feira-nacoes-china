# =========================================================================
# CONFIGURAÇÃO DE VARIÁVEIS DE AMBIENTE - FEIRA DAS NAÇÕES CHINA
# =========================================================================
# Renomeie este arquivo para '.env' para desenvolvimento local ou insira
# estas chaves no painel de configurações (Environment Variables) da Vercel.

# 1. Chave da API do Google Gemini (para Provérbios Dinâmicos por I.A.)
VITE_GEMINI_API_KEY=sua_gemini_api_key_aqui

# 2. Credenciais do Firebase (Preencha para desativar o Mock Mode e usar banco real)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
